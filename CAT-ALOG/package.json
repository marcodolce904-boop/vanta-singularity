{
  "name": "cat-alog",
  "productName": "CAT-ALOG",
  "version": "1.0.0",
  "description": "App desktop personale: catalogo di strutture flex, componenti, classi e variabili root",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "smoke": "xvfb-run -a -s \"-screen 0 1440x900x24\" node scripts/smoke-electron.js",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.catalog.catalog",
    "productName": "CAT-ALOG",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CAT-ALOG-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "buildResources": "build"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CAT-ALOG",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "CAT-ALOG"
}
